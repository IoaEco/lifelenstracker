{
  "expo": {
    "name": "LifeLens",
    "slug": "lifelens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifelens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ioaeco.lifelens",
      "infoPlist": {
        "NSCameraUsageDescription": "LifeLens uses the camera to capture your progress photos.",
        "NSMotionUsageDescription": "LifeLens uses motion sensors to help you align photos consistently.",
        "NSPhotoLibraryUsageDescription": "LifeLens needs access to your photo library to save your progress photos.",
        "NSPhotoLibraryAddUsageDescription": "LifeLens saves your progress photos to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ioaeco.lifelens",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://lifelens.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "LifeLens uses the camera to capture your progress photos.",
          "microphonePermission": "false"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "LifeLens needs access to your photo library to save your before/after images.",
          "savePhotosPermission": "LifeLens needs permission to save your before/after images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "aa58a17e-91f7-4621-bc01-cc3cfc7ae8e0"
      }
    },
    "owner": "reconoclast"
  }
}
